{
  "name": "sea-lite",
  "version": "0.7.1",
  "description": "MCP work queue for parallel coding agents: claim fencing, path-scoped claims, typed links, atomic batches, hash-chained history (composes with kronicle-lite).",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sea-lite": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "hooks",
    "skills",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "catalog:snapshot": "npm run build && mcp-catalog-snap snapshot --server sea-lite",
    "catalog:check": "npm run build && mcp-catalog-snap check --server sea-lite",
    "prepublishOnly": "npm run build",
    "serve": "node dist/cli.js serve"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "work-queue",
    "tickets",
    "claim-fencing",
    "lease",
    "parallel-agents",
    "file-locking",
    "scope",
    "sqlite",
    "hash-chain",
    "kronicle-lite"
  ],
  "author": "IsoKron (https://isokron.ai)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isokron-ai/sea-lite.git"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^12.6.0",
    "kronicle-lite": "^0.10.0",
    "picomatch": "^4.0.7",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/picomatch": "^4.0.3",
    "eslint": "^9.39.0",
    "mcp-catalog-snap": "^0.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "mcpName": "io.github.rafe-walker/sea-lite"
}
