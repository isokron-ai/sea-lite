{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/sea-lite-scope-check.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y sea-lite release-worktree --hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
